# setup.py generates independent local credentials. Never commit .env or secrets/.
NEO4J_PASSWORD=
MONGO_PASSWORD=
INFLUX_DATABASE=brahmastra
MONGO_DATABASE=brahmastra
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
SIMILARITY_THRESHOLD=0.65
SIMILARITY_TOP_K=5
KEYWORD_MIN_SHARED=2
CHUNK_CHARS=1800
# Optional vision model (VLM) for "Ingest + VLM": any OpenAI-compatible chat-completions endpoint, including /v1.
# Examples: VLM_BASE_URL=https://openrouter.ai/api/v1 with a vision model and VLM_API_KEY, or a self-hosted server
# such as http://host.docker.internal:8002/v1 serving nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16. Leave empty if unused.
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT=120
# Containers reach a host-local model via http://host.docker.internal:<port>/v1.
QDRANT_COLLECTION=document_chunks

# Language models for the Mission Analysis Agent. Set at least ONE of: a self-hosted OpenAI-compatible server
# (LLM_BASE_URL, including /v1), OPENROUTER_API_KEY or GROQ_API_KEY below. See docs/00-installation.md, step 4.
# Self-hosted examples: http://host.docker.internal:8000/v1 (vLLM on this machine), http://my-gpu-server:8000/v1,
# http://host.docker.internal:11434/v1 (Ollama, with LLM_MODEL=gpt-oss:20b). Leave empty if you use a hosted provider.
LLM_BASE_URL=
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Read-only browser viewers (generated by setup.py)
VIEWER_PASSWORD=
VIEWER_SESSION_SECRET=

# Mission Analysis Agent (generated by setup.py)
AGENT_MONGO_PASSWORD=
AGENT_ADMIN_USER=admin
AGENT_ADMIN_PASSWORD=

# Optional hosted models for the agent (selectable per role under Administration → Models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Agent limits per question
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_REVISIONS=5
AGENT_MAX_MODEL_CALLS=100
AGENT_MAX_MINUTES=15
AGENT_MAX_RETRIES=2

# Published container images (docker compose pull). Change to build and push your own.
IMAGE_NAMESPACE=ssri14
IMAGE_TAG=1.0.10
