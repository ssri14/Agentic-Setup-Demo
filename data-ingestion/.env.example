# setup.py generates independent local credentials. Never commit .env or secrets/.
NEO4J_PASSWORD=
MONGO_PASSWORD=
INFLUX_DATABASE=brahmastra
MONGO_DATABASE=brahmastra
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
SIMILARITY_THRESHOLD=0.65
SIMILARITY_TOP_K=5
KEYWORD_MIN_SHARED=2
CHUNK_CHARS=1800
# Optional OpenAI-compatible chat-completions VLM, e.g. OpenRouter or local server.
# Base URL must include /v1 when required by the provider.
VLM_BASE_URL=http://10.20.30.57:8002/v1
VLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-BF16
VLM_API_KEY=
VLM_TIMEOUT=120
# Containers reach a host-local model via http://host.docker.internal:<port>/v1.
QDRANT_COLLECTION=document_chunks

# Text LLM for the Mission Analysis Agent (OpenAI-compatible; the LAN gpt-oss-120b server in the reference setup).
LLM_BASE_URL=http://10.20.30.57:8000/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Read-only browser viewers (generated by setup.py)
VIEWER_PASSWORD=
VIEWER_SESSION_SECRET=

# Mission Analysis Agent (generated by setup.py)
AGENT_MONGO_PASSWORD=
AGENT_ADMIN_USER=admin
AGENT_ADMIN_PASSWORD=

# Optional hosted models for the agent (selectable per role under Administration → Models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Agent limits per question
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_REVISIONS=5
AGENT_MAX_MODEL_CALLS=100
AGENT_MAX_MINUTES=15
AGENT_MAX_RETRIES=2

# Published container images (docker compose pull). Change to build and push your own.
IMAGE_NAMESPACE=ssri14
IMAGE_TAG=1.0.10
