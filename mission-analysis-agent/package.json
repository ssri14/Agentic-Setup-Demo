{
  "name": "mission-analysis-agent",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "Mission Analysis Agent: web chat over mission documents and telemetry with a replayable Plan-Execute-Verify-Replan agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "provision": "node dist/server/provision.js",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "mongodb": "7.9.0",
    "neo4j-driver": "6.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "mingo": "7.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
